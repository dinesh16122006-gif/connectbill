# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave empty for automatic local in-memory fallback, or specify MongoDB Atlas / local URI:
# MONGODB_URI=mongodb://127.0.0.1:27017/connectbill
MONGODB_URI=

# Authentication
JWT_SECRET=connectbill_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_sample
# When set to true or when dummy keys are used, simulation mode provides full end-to-end checkout & signature verification
RAZORPAY_SIMULATE=true

# OTP & SMS Provider Configuration
MOCK_OTP_MODE=true
FIXED_DEV_OTP=123456
OTP_PROVIDER_KEY=dev_otp_key
SMS_PROVIDER_ID=CONNECTBILL_SMS

# CORS & URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
